{
        "inputs": [
            {
               "name": "Sample options",
               "description": "Parameters relating to the sample being analysed.",
               "advanced": false,
                "params": {
                    "samplesheet": {
                        "name": "Samples",
                        "description": "The samples to process.",
                        "required": true,
                        "type": "csv",
                        "takes_samples": true,
                        "columns": [
                            {
                                "name": "sampleName",
                                "type": "string",
                                "from_sample": "name",
                                "required": true,
                                "render": false
                            },
                            {
                                "name": "bamPath",
                                "type": "data",
                                "required": true,
                                "render": true,
                                "data_types": [
                                    "bam_file"
                                ]
                            },
                            {
                                "name": "genomePath",
                                "type": "data",
                                "required": true,
                                "render": true,
                                "data_types": [
                                    "genome_file"
                                ]
                            },
                            {
                                "name": "genomeName",
                                "type": "string",
                                "required": false,
                                "render": false
                            }
                        ]
                    }
                }
            },
            {
                "name": "Pipeline Parameters",
                "description": "General options and configuration for the pipeline.",
                "advanced": true,
                "params": {
                    "sclenLength": {
                        "name": "Soft clipping length filter",
                        "description": "Minimum number of soft-clipped bases for reads to be kept.",
                        "type": "number",
                        "default": 1000
                    },
                    "hclenLength": {
                        "name": "Hard clipping length filter",
                        "description": "Minimum number of hard-clipped bases for reads to be kept.",
                        "type": "number",
                        "default": 1000
                    },
                    "rlenLength": {
                        "name": "Reference alignment length filter",
                        "description": "Minimum number of bases that must align to the genome to be kept.",
                        "type": "number",
                        "default": 1000
                    },
                    "min_bam_size": {
                        "name": "Minimum bam file size",
                        "description": "Minimum size in bytes for an empty bam file",
                        "type": "number",
                        "default": 500
                    },
                    "bedgraph_bin_size": {
                        "name": "Bedgraph bin size in bases",
                        "description": "Number of bases to be considered a bin when generating coverage bedgraph files.",
                        "type": "number",
                        "default": 10000
                    }
                }
            }
        ],
        "outputs": [
            {
                "name": "Filtered coverage bedgraph",
                "description": "Coverage bedgraph produced after filtering for genome alignment.",
                "filetype": "^.*\\.bedgraph$",
                "process": "BAM_COV_RLEN"
            }
        ]
    }