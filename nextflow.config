/*
Nextflow config file
*/

// Default params, used in configs
params {
	// Pipeline params
	inputFile			= 'inputFile_main_placeholder'
	sclenLength			= 1000
	hclenLength			= 1000
	rlenLength			= 400
	outdir				= 'results'
	publish_dir_mode	= 'copy'
	min_bam_size        = 500 // Min size in bytes for an empty bam file
	bedgraph_bin_size	= 10000
}

profiles {
	docker {
		docker.enabled         	 = true
        conda.enabled          	 = false
        singularity.enabled    	 = false
        podman.enabled         	 = false
        shifter.enabled        	 = false
        charliecloud.enabled   	 = false
        apptainer.enabled   	 = false
		//process.container	   	 = 'edwardward762/transgenemapping:latest'
	}

	test { 
		includeConfig 'conf/test.config' 
	}
}

docker.registry      = 'quay.io'

includeConfig 'conf/modules.config'